# Copie privée : deploy/.env (mode 0600). PostgreSQL natif existant.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=idee
DB_USER=idee
DB_PASSWORD=
DB_CONTEXTS=production
IDEE_IMPORT_TOKEN=
IDEE_PUBLIC_ORIGIN=https://idees.cavousdit.com
# Import quotidien par idee-import.timer ; false dans le service API.
DATATOURISME_API_KEY=
DATATOURISME_ENABLED=false
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-2603
MISTRAL_AUTO_ENABLED=true
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_TRANSLATIONS_ENABLED=true
IDEE_IMAGES_ENABLED=true
